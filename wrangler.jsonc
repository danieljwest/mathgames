{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "math-west-best",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "math.west.best",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
